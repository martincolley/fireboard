{
	"name": "fireboard",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "nuxt dev --host 127.0.0.1 --port 4321",
		"build": "nuxt build",
		"start": "NITRO_HOST=127.0.0.1 NITRO_PORT=4321 node .output/server/index.mjs",
		"postinstall": "nuxt prepare",
		"lint": "oxlint",
		"format": "oxfmt",
		"format:check": "oxfmt --check",
		"typecheck": "vue-tsc -b --noEmit",
		"test": "vitest run",
		"build:cloud": "FIREBOARD_MODE=cloud nuxt build",
		"dev:cloud": "npm run build:cloud && wrangler dev --port 8788 --ip 127.0.0.1",
		"deploy:cloud": "npm run build:cloud && wrangler deploy",
		"db:migrate:local": "wrangler d1 migrations apply fireboard --local",
		"db:migrate:remote": "wrangler d1 migrations apply fireboard --remote",
		"companion": "FIREBOARD_ALLOWED_ORIGINS=${FIREBOARD_ALLOWED_ORIGINS:-} npm run dev"
	},
	"dependencies": {
		"@better-auth/stripe": "^1.7.7",
		"@fontsource/bricolage-grotesque": "^5.3.0",
		"@fontsource/ibm-plex-sans": "^5.3.0",
		"@fontsource/jetbrains-mono": "^5.3.0",
		"@google-cloud/firestore": "9.3.1",
		"@modelcontextprotocol/sdk": "^1.32.0",
		"@noble/hashes": "^2.4.0",
		"@vite-pwa/nuxt": "^1.1.1",
		"better-auth": "^1.7.7",
		"firebase-admin": "^14.5.0",
		"naive-ui": "^2.45.3",
		"nuxt": "^4.5.2",
		"nuxt-security": "^2.6.0",
		"stripe": "^22.6.2",
		"vue": "^3.5.0",
		"zod": "^4.6.5"
	},
	"devDependencies": {
		"@cloudflare/workers-types": "^5.20261003.1",
		"@vicons/ionicons5": "^0.13.0",
		"oxfmt": "^0.71.0",
		"oxlint": "^1.86.0",
		"typescript": "^5.9.0",
		"vitest": "^3.2.4",
		"vue-tsc": "^3.3.12",
		"wrangler": "^4.147.0"
	},
	"license": "FSL-1.1-MIT"
}
