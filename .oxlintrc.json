{
	"$schema": "./node_modules/oxlint/configuration_schema.json",
	"plugins": [
		"typescript"
	],
	"categories": {
		"correctness": "error"
	},
	"rules": {
		"no-console": [
			"warn",
			{
				"allow": [
					"warn",
					"error",
					"info"
				]
			}
		],
		"typescript/no-explicit-any": "error",
		"typescript/ban-ts-comment": "error"
	},
	"overrides": [
		{
			"files": [
				"scripts/**"
			],
			"rules": {
				"no-console": "off"
			}
		}
	]
}
