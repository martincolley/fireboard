{
	"semi": false,
	"singleQuote": true,
	"tabWidth": 2,
	"trailingComma": "none",
	"printWidth": 100,
	"useTabs": true,
	"vueIndentScriptAndStyle": false,
	"bracketSpacing": true,
	"arrowParens": "always",
	"proseWrap": "never",
	"bracketSameLine": true,
	"htmlWhitespaceSensitivity": "ignore",
	// Prose pages: keep inline links and code attached to the punctuation after them.
	"overrides": [
		{
			"files": ["app/pages/docs/**", "app/components/landing/**", "app/components/docs/**"],
			"options": { "htmlWhitespaceSensitivity": "css" }
		}
	]
}
